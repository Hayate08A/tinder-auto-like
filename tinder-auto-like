/*
 * Tinderプロフィール自動判定（iPhone・PC共通）
 *
 * iPhoneショートカット:
 * 1. 「40回繰り返す」を追加
 * 2. 繰り返し内の「WebページでJavaScriptを実行」に
 *    このファイル全体を貼り付ける
 * 3. 入力を「ショートカットの入力（Safari Webページ）」に指定
 * 4. JavaScriptの直後に「0.5秒待機」を追加
 *
 * PC:
 * Tinderを開いたブラウザのConsoleへ、このファイル全体を貼り付ける。
 * 設定した間隔で判定を続ける。停止は tinderAutoJudge.stop() で行う。
 *
 * メンバーがいない画面では次のカテゴリーへ移動します。
 * 一覧の最後のカテゴリーの次は最初へ戻ります。
 *
 * PC操作:
 * tinderAutoJudge.status()       状態確認
 * tinderAutoJudge.stop()         停止
 * tinderAutoJudge.start()        再開
 * tinderAutoJudge.resetHistory() 判定済み履歴の消去
 */

(() => {
  const CONFIG = Object.freeze({
    maxDistanceKm: 69,
    ngKeywords: [
      "男の娘",
      "ゲイ",
      "ホモ",
      "らいん",
      "ら い ん",
      "ら-い-ん",
      "ライン",
      "ラ-イ-ン ",
      "ラ イ ン",
    ],
    blockLineMentions: false,
    intervalMs: 1500,
    profileOpenFallbackAfterMs: 3000,
    profileLoadingRotationThreshold: 5,
    categoryTransitionWaitMs: 4000,
    newRunAfterMs: 200,
  });

  const STORAGE = Object.freeze({
    categoryRotation: "tinderAutoJudge.categoryRotation.v2",
    seen: "tinderAutoJudge.seenProfiles",
    decisions: "tinderAutoJudge.currentRunDecisions",
    log: "tinderAutoJudge.currentRunLog",
    lastStepAt: "tinderAutoJudge.lastStepAt",
  });

  const DISTANCE_PATTERN = /^(\d[\d,]*(?:\.\d+)?)\s*km\s*先$/i;

  const OBFUSCATION_SEPARATOR_PATTERN = /[\p{P}\p{S}\p{Z}\p{Cf}\s_ー]+/gu;

  const LATIN_LINE_PATTERN =
    /(?:^|[^a-z0-9])l[\p{P}\p{S}\p{Z}\p{Cf}\s_]*i[\p{P}\p{S}\p{Z}\p{Cf}\s_]*n[\p{P}\p{S}\p{Z}\p{Cf}\s_]*e(?=$|[^a-z0-9])/iu;

  const SMALL_HIRAGANA_MAP = Object.freeze({
    ぁ: "あ",
    ぃ: "い",
    ぅ: "う",
    ぇ: "え",
    ぉ: "お",
    っ: "つ",
    ゃ: "や",
    ゅ: "ゆ",
    ょ: "よ",
    ゎ: "わ",
  });

  function normalizeText(value) {
    return String(value ?? "")
      .normalize("NFKC")
      .toLocaleLowerCase("ja-JP")
      .replace(/[\u200B-\u200D\uFEFF]/g, "")
      .replace(/\s+/g, " ")
      .trim();
  }

  function katakanaToHiragana(value) {
    return value.replace(/[\u30A1-\u30F6]/g, (character) =>
      String.fromCharCode(character.charCodeAt(0) - 0x60),
    );
  }

  function normalizeKanaForObfuscatedMatching(value) {
    return katakanaToHiragana(normalizeText(value))
      .replace(
        /[ぁぃぅぇぉっゃゅょゎ]/g,
        (character) => SMALL_HIRAGANA_MAP[character] || character,
      )
      .replace(OBFUSCATION_SEPARATOR_PATTERN, "");
  }

  function containsLineMention(value) {
    const normalized = normalizeText(value);
    const normalizedKana = normalizeKanaForObfuscatedMatching(normalized);
    const normalizedKanaWithoutOnline = normalizedKana.replace(
      /おんらいん/g,
      "",
    );

    return (
      normalizedKanaWithoutOnline.includes("らいん") ||
      LATIN_LINE_PATTERN.test(normalized)
    );
  }

  function parseDistanceTexts(values) {
    const distances = [];

    for (const value of values) {
      const match = normalizeText(value).match(DISTANCE_PATTERN);
      if (!match) continue;

      const distance = Number(match[1].replaceAll(",", ""));
      if (Number.isFinite(distance)) distances.push(distance);
    }

    return [...new Set(distances)];
  }

  function evaluateRules({
    profileText,
    distanceKm,
    maxDistanceKm = CONFIG.maxDistanceKm,
    ngKeywords = CONFIG.ngKeywords,
    blockLineMentions = CONFIG.blockLineMentions,
  }) {
    const normalizedProfile = normalizeText(profileText);
    const lineMentionDetected = containsLineMention(profileText);
    const reasons = [];

    if (distanceKm !== null && distanceKm >= maxDistanceKm) {
      reasons.push({
        type: "distance",
        value: distanceKm,
        message: `${distanceKm}km先（${maxDistanceKm}km以上）`,
      });
    }

    for (const keyword of ngKeywords) {
      const normalizedKeyword = normalizeText(keyword);

      if (normalizedKeyword && normalizedProfile.includes(normalizedKeyword)) {
        reasons.push({
          type: "keyword",
          value: keyword,
          message: `NG文字列「${keyword}」`,
        });
      }
    }

    if (blockLineMentions && lineMentionDetected) {
      reasons.push({
        type: "line",
        message: "LINEへの言及",
      });
    }

    return {
      action: reasons.length > 0 ? "Nope" : "Like",
      reasons,
      lineMentionDetected,
    };
  }

  function formatNopeReason(reason) {
    if (reason.type === "distance") {
      return `判定距離外（${reason.message}）`;
    }

    if (reason.type === "line") {
      return "LINE誘導";
    }

    return reason.message;
  }

  function createLineMentionProfileLog({
    profileId,
    profileName,
    profileText,
    distanceKm,
  }) {
    return {
      profileId,
      profileName,
      distanceKm,
      profileText,
      capturedAt: new Date().toISOString(),
    };
  }

  function createDecisionLogFields({
    action,
    profileName,
    distanceKm,
    reasonLabels,
  }) {
    const isLike = action === "Like";
    const emoji = isLike ? "❤️" : "❌";
    const displayAction = isLike ? "LIKE" : "NOPE";
    const normalizedReasons = reasonLabels.length > 0 ? reasonLabels : ["なし"];
    const distanceLabel =
      distanceKm === null || distanceKm === undefined
        ? "距離不明"
        : `${distanceKm}km`;
    const summary =
      `${emoji} ${displayAction}｜${profileName}｜${distanceLabel}｜` +
      `理由: ${normalizedReasons.join("・")}`;

    return {
      emoji,
      displayAction,
      reasonLabels: normalizedReasons,
      summary,
      message: summary,
    };
  }

  if (typeof module !== "undefined" && module.exports) {
    module.exports = {
      CONFIG,
      normalizeText,
      normalizeKanaForObfuscatedMatching,
      containsLineMention,
      parseDistanceTexts,
      evaluateRules,
    };
  }

  if (typeof document === "undefined") return;

  let profileOpenMissingSince = 0;
  let profileLoadingConsecutiveCount = 0;
  let lastProcessedProfileId = null;
  const profileIdsInCurrentCategory = new Set();
  const fallbackClickedAriaLabels = new Set();
  // Safariショートカットは毎回コードを実行し直すので、遷移状態を保存する。
  function readCategoryRotation() {
    try {
      return JSON.parse(sessionStorage.getItem(STORAGE.categoryRotation)) || {};
    } catch {
      return {};
    }
  }

  function saveCategoryRotation(state) {
    sessionStorage.setItem(STORAGE.categoryRotation, JSON.stringify(state));
  }

  function isSuppressed(element) {
    return Boolean(
      element.closest('[aria-hidden="true"], [inert], .Hidden, script, style'),
    );
  }

  function readJsonArray(key) {
    try {
      const value = JSON.parse(sessionStorage.getItem(key) || "[]");
      return Array.isArray(value) ? value : [];
    } catch {
      return [];
    }
  }

  function readSeenProfiles() {
    const sessionProfiles = readJsonArray(STORAGE.seen);

    try {
      const localValue = JSON.parse(localStorage.getItem(STORAGE.seen) || "[]");
      const localProfiles = Array.isArray(localValue) ? localValue : [];
      const mergedProfiles = [
        ...new Set([...localProfiles, ...sessionProfiles]),
      ];

      localStorage.setItem(STORAGE.seen, JSON.stringify(mergedProfiles));
      sessionStorage.removeItem(STORAGE.seen);
      return mergedProfiles;
    } catch {
      return sessionProfiles;
    }
  }

  function writeSeenProfiles(profiles) {
    const serialized = JSON.stringify([...profiles]);

    try {
      localStorage.setItem(STORAGE.seen, serialized);
      sessionStorage.removeItem(STORAGE.seen);
    } catch {
      sessionStorage.setItem(STORAGE.seen, serialized);
    }
  }

  function resetCurrentRun() {
    sessionStorage.setItem(STORAGE.decisions, "0");
    sessionStorage.setItem(STORAGE.log, "[]");
    sessionStorage.setItem(STORAGE.lastStepAt, String(Date.now()));
  }

  function ensureCurrentRun() {
    const now = Date.now();
    const previous = Number(sessionStorage.getItem(STORAGE.lastStepAt) || "0");

    if (previous === 0 || now - previous > CONFIG.newRunAfterMs) {
      resetCurrentRun();
    } else {
      sessionStorage.setItem(STORAGE.lastStepAt, String(now));
    }
  }

  function getOpenedProfile() {
    return document.querySelector("main .profileContent");
  }

  function hasDetailMarkers(profile) {
    const markers = new Set(["基本情報", "求めるものは"]);

    return [...profile.querySelectorAll("h1, h2, h3")]
      .filter((element) => !isSuppressed(element))
      .some((element) => markers.has(element.textContent.trim()));
  }

  function getProfileId(profile) {
    const photos = [...profile.querySelectorAll('[style*="background-image"]')];

    for (const photo of photos) {
      const backgroundImage = photo.style.backgroundImage || "";
      const match = backgroundImage.match(/\/u\/([^/)"?]+)/);

      if (match) return match[1];
    }

    return null;
  }

  function getProfileName(profile) {
    return (
      profile
        .querySelector("h1[aria-label]")
        ?.getAttribute("aria-label")
        ?.replace(/\s+\d+歳$/, "")
        .trim() ||
      profile.querySelector("h1 span")?.textContent.trim() ||
      "不明"
    );
  }

  function getProfileText(profile) {
    const texts = [];
    const walker = document.createTreeWalker(profile, NodeFilter.SHOW_TEXT);

    let node;
    while ((node = walker.nextNode())) {
      const parent = node.parentElement;
      if (!parent || isSuppressed(parent)) continue;

      const text = normalizeText(node.nodeValue);
      if (text) texts.push(text);
    }

    return texts.join(" ");
  }

  function getDistances(profile) {
    const values = [...profile.querySelectorAll("div, span, p, li")]
      .filter(
        (element) => element.children.length === 0 && !isSuppressed(element),
      )
      .map((element) => element.textContent);

    return parseDistanceTexts(values);
  }

  function isEnabledActionElement(element) {
    return Boolean(
      element &&
      !element.disabled &&
      element.getAttribute("aria-disabled") !== "true" &&
      !isSuppressed(element),
    );
  }

  function findButton(labelText) {
    const expectedLabel = normalizeText(labelText);

    for (const button of document.querySelectorAll("button")) {
      const names = [
        button.getAttribute("aria-label"),
        button.getAttribute("title"),
        button.textContent,
      ]
        .map(normalizeText)
        .filter(Boolean);

      if (names.includes(expectedLabel) && isEnabledActionElement(button)) {
        return button;
      }
    }

    for (const label of document.querySelectorAll("span.Hidden")) {
      if (normalizeText(label.textContent) !== expectedLabel) continue;

      const actionElement =
        label.closest('button, [role="button"]') ||
        (expectedLabel === normalizeText("プロフィールを開く")
          ? label.parentElement
          : null);

      if (isEnabledActionElement(actionElement)) return actionElement;
    }

    return null;
  }

  function clearProfileOpenFallbackState() {
    profileOpenMissingSince = 0;
    profileLoadingConsecutiveCount = 0;
    fallbackClickedAriaLabels.clear();
  }

  function getExploreCategoryButtons() {
    // 見出し文言やsection数に依存せず、表示順に全カテゴリーを取得。
    return [
      ...document.querySelectorAll("#catalog-page button[aria-label]"),
    ].filter(
      (button) => button.querySelector("h3") && isEnabledActionElement(button),
    );
  }

  function getExploreCategoryLabel(button) {
    const heading = button.querySelector("h3");
    if (heading && normalizeText(heading.textContent)) {
      return heading.textContent.trim();
    }

    return String(button.getAttribute("aria-label") || "")
      .replace(/\s+-\s+.*$/, "")
      .trim();
  }

  function getCurrentExploreCategoryLabel(buttons) {
    const current = buttons.find(
      (button) => button.getAttribute("aria-current") === "page",
    );
    if (current) return getExploreCategoryLabel(current);
    return document.querySelector("main nav h2")?.textContent.trim() || "";
  }

  function clickNextExploreCategory() {
    const buttons = getExploreCategoryButtons();
    if (!buttons.length) return null;

    const state = readCategoryRotation();
    const currentLabel =
      getCurrentExploreCategoryLabel(buttons) || state.lastLabel;
    const currentIndex = buttons.findIndex(
      (button) => getExploreCategoryLabel(button) === currentLabel,
    );
    let nextIndex = buttons.findIndex(
      (button) => getExploreCategoryLabel(button) === state.pendingLabel,
    );
    if (nextIndex < 0) nextIndex = (currentIndex + 1) % buttons.length;

    const button = buttons[nextIndex];
    const categoryLabel = getExploreCategoryLabel(button);
    button.click();
    saveCategoryRotation({
      lastLabel: categoryLabel,
      waitingUntil: Date.now() + CONFIG.categoryTransitionWaitMs,
    });
    profileIdsInCurrentCategory.clear();
    lastProcessedProfileId = null;
    clearProfileOpenFallbackState();
    return categoryLabel;
  }

  function isRendered(element) {
    return !isSuppressed(element) && element.getClientRects().length > 0;
  }

  function findEmptyExploreState() {
    // 本文の自己紹介には反応せず、終了ダイアログの見出しと
    // プロフィールカード内の既知の終了案内のみを調べる。
    const dialogs = [...document.querySelectorAll('main [role="dialog"]')];
    const dialog = dialogs.find(
      (element) =>
        isRendered(element) &&
        [...element.querySelectorAll("h1, h2, h3")].some((heading) =>
          normalizeText(heading.textContent).includes(
            "近くに新しいメンバーはいないみたい",
          ),
        ),
    );
    if (dialog) return dialog;
    return (
      [
        ...document.querySelectorAll(
          'main [aria-label="プロフィールカード"] div',
        ),
      ].find(
        (element) =>
          element.children.length === 0 &&
          isRendered(element) &&
          normalizeText(element.textContent).startsWith(
            "まわりにメンバーがもういないみたい",
          ),
      ) || null
    );
  }

  function handleEmptyExploreState(decisionCount) {
    const state = readCategoryRotation();
    if (Date.now() < (state.waitingUntil || 0)) {
      return {
        status: "waiting",
        message: "カテゴリーの切り替え待ちです",
        decisionCount,
      };
    }
    const emptyState = findEmptyExploreState();
    if (!emptyState && !state.pendingLabel && !state.returningToExplore)
      return null;

    // モーダルがある場合は、先に閉じてから次回のステップで移動。
    const returnButton =
      emptyState &&
      [...emptyState.querySelectorAll("button")].find(
        (button) =>
          isEnabledActionElement(button) &&
          normalizeText(button.textContent) === "exploreに戻る",
      );
    if (returnButton) {
      const buttons = getExploreCategoryButtons();
      const currentLabel =
        getCurrentExploreCategoryLabel(buttons) || state.lastLabel;
      const currentIndex = buttons.findIndex(
        (button) => getExploreCategoryLabel(button) === currentLabel,
      );
      const nextButton = buttons[(currentIndex + 1) % buttons.length];
      returnButton.click();
      saveCategoryRotation({
        lastLabel: currentLabel,
        pendingLabel: nextButton
          ? getExploreCategoryLabel(nextButton)
          : state.pendingLabel,
        returningToExplore: true,
        waitingUntil: Date.now() + CONFIG.categoryTransitionWaitMs,
      });
      return {
        status: "returned-to-explore",
        message: "メンバーがいないためExploreに戻りました",
        decisionCount,
      };
    }

    const clickedCategory = clickNextExploreCategory();
    return clickedCategory
      ? {
          status: "clicked-explore-category",
          trigger: "no-members",
          message: `メンバーがいないため「${clickedCategory}」へ切り替えました`,
          clickedCategory,
          decisionCount,
        }
      : {
          status: "waiting",
          message: "次のカテゴリー一覧の表示待ちです",
          decisionCount,
        };
  }

  function isVisibleActionElement(element) {
    if (
      element.disabled ||
      element.getAttribute("aria-disabled") === "true" ||
      isSuppressed(element)
    ) {
      return false;
    }

    const rect = element.getBoundingClientRect();
    const viewportHeight =
      window.innerHeight || document.documentElement.clientHeight;

    return (
      rect.width > 0 &&
      rect.height > 0 &&
      rect.bottom > 0 &&
      rect.top < viewportHeight
    );
  }

  function isExcludedFallbackLabel(label) {
    const excludedLabels = new Set([
      "ブースト",
      "previous photo",
      "次の写真",
      "nope",
      "super like",
      "like",
      "ファーストリアクション",
      "閉じる",
      "結構です",
      "super likeを送ろう",
    ]);

    return (
      excludedLabels.has(label) ||
      label.includes(normalizeText("プロフィールを開く"))
    );
  }

  function clickNextAriaLabelFallback() {
    const dialogs = [...document.querySelectorAll('[role="dialog"]')].filter(
      (dialog) => !isSuppressed(dialog),
    );
    const profileCard = document.querySelector(
      'main [aria-label="プロフィールカード"]',
    );
    const searchRoot =
      dialogs.length > 0 ? dialogs[dialogs.length - 1] : profileCard;

    if (!searchRoot) return null;

    const candidates = [
      ...searchRoot.querySelectorAll(
        'button[aria-label], [role="button"][aria-label], input[aria-label]',
      ),
    ]
      .map((element, documentOrder) => ({
        element,
        documentOrder,
        label: normalizeText(element.getAttribute("aria-label")),
        rect: element.getBoundingClientRect(),
      }))
      .filter(
        ({ element, label }) =>
          label &&
          !fallbackClickedAriaLabels.has(label) &&
          !isExcludedFallbackLabel(label) &&
          isVisibleActionElement(element),
      )
      .sort(
        (left, right) =>
          left.rect.top - right.rect.top ||
          left.rect.left - right.rect.left ||
          left.documentOrder - right.documentOrder,
      );

    const candidate = candidates[0];
    if (!candidate) return null;

    fallbackClickedAriaLabels.add(candidate.label);
    candidate.element.click();
    return candidate.label;
  }

  function handleMissingProfileOpenButton(decisionCount) {
    const now = Date.now();

    if (profileOpenMissingSince === 0) {
      profileOpenMissingSince = now;
    }

    const waitingMs = now - profileOpenMissingSince;
    const tinderIsLoading = Boolean(
      document.querySelector(
        'main [aria-label="プロフィールカード"] [aria-busy="true"]',
      ),
    );

    if (tinderIsLoading) {
      profileLoadingConsecutiveCount += 1;

      if (
        profileLoadingConsecutiveCount >= CONFIG.profileLoadingRotationThreshold
      ) {
        const loadingConsecutiveCount = profileLoadingConsecutiveCount;
        const clickedCategory = clickNextExploreCategory();

        if (clickedCategory) {
          profileLoadingConsecutiveCount = 0;
          profileOpenMissingSince = now;
          fallbackClickedAriaLabels.clear();

          return {
            status: "clicked-explore-category",
            message:
              `プロフィール読み込みが${loadingConsecutiveCount}回続いたため` +
              `「${clickedCategory}」へ切り替えました`,
            clickedCategory,
            loadingConsecutiveCount,
            decisionCount,
          };
        }
      }

      return {
        status: "waiting",
        message: "Tinder側でプロフィールを読み込んでいます",
        loadingConsecutiveCount: profileLoadingConsecutiveCount,
        waitingMs,
        decisionCount,
      };
    }

    profileLoadingConsecutiveCount = 0;

    if (waitingMs >= CONFIG.profileOpenFallbackAfterMs) {
      const clickedLabel = clickNextAriaLabelFallback();

      if (clickedLabel) {
        return {
          status: "clicked-aria-fallback",
          message: `プロフィール待機が5秒続いたため「${clickedLabel}」を押しました`,
          clickedAriaLabel: clickedLabel,
          waitingMs,
          decisionCount,
        };
      }

      const clickedCategory = clickNextExploreCategory();

      if (clickedCategory) {
        profileOpenMissingSince = now;
        fallbackClickedAriaLabels.clear();

        return {
          status: "clicked-explore-category",
          message:
            `プロフィール操作が${Math.round(waitingMs / 1000)}秒見つからないため` +
            `「${clickedCategory}」へ切り替えました`,
          trigger: "missing-profile-open-button",
          clickedCategory,
          waitingMs,
          decisionCount,
        };
      }
    }

    return {
      status: "waiting",
      message: "操作可能な「プロフィールを開く」が見つかりません",
      waitingMs,
      decisionCount,
    };
  }

  function findLikeUpgradeDismissButton() {
    const expectedTitle = normalizeText("Likeをアップグレードしよう！");

    for (const dialog of document.querySelectorAll('[role="dialog"]')) {
      if (isSuppressed(dialog)) continue;

      const isLikeUpgradeDialog = [
        ...dialog.querySelectorAll("h1, h2, h3"),
      ].some((heading) => normalizeText(heading.textContent) === expectedTitle);

      if (!isLikeUpgradeDialog) continue;

      const dismissButton = [...dialog.querySelectorAll("button")].find(
        (button) =>
          !button.disabled &&
          !isSuppressed(button) &&
          normalizeText(button.textContent) === normalizeText("結構です"),
      );

      if (dismissButton) return dismissButton;
    }

    return null;
  }

  function appendLog(entry) {
    const log = readJsonArray(STORAGE.log);
    log.push(entry);
    sessionStorage.setItem(STORAGE.log, JSON.stringify(log.slice(-100)));
  }

  function runStep() {
    try {
      ensureCurrentRun();

      const decisionCount = Number(
        sessionStorage.getItem(STORAGE.decisions) || "0",
      );

      const likeUpgradeDismissButton = findLikeUpgradeDismissButton();

      if (likeUpgradeDismissButton) {
        likeUpgradeDismissButton.click();

        return {
          status: "dismissed-like-upgrade",
          message: "Likeアップグレード画面で「結構です」を押しました",
          decisionCount,
        };
      }

      // 終了画面は、背後に残っているプロフィールより先に処理する。
      const categoryResult = handleEmptyExploreState(decisionCount);
      if (categoryResult) return categoryResult;

      const profile = getOpenedProfile();

      // 詳細が閉じているときは、この呼び出しでは開くだけ。
      if (!profile) {
        const openButton = findButton("プロフィールを開く");

        if (!openButton) {
          return handleMissingProfileOpenButton(decisionCount);
        }

        clearProfileOpenFallbackState();
        openButton.click();

        return {
          status: "opened",
          message: "プロフィールを開きました",
          decisionCount,
        };
      }

      clearProfileOpenFallbackState();

      if (!hasDetailMarkers(profile)) {
        return {
          status: "waiting",
          message: "プロフィール詳細の読み込み待ちです",
          decisionCount,
        };
      }

      const profileId = getProfileId(profile);
      const profileName = getProfileName(profile);

      if (!profileId) {
        return {
          status: "waiting",
          message: "プロフィールIDを取得できません",
          profileName,
          decisionCount,
        };
      }

      const isConsecutiveProfile = lastProcessedProfileId === profileId;
      const isRepeatedInCategory = profileIdsInCurrentCategory.has(profileId);

      if (isConsecutiveProfile || isRepeatedInCategory) {
        const clickedCategory = clickNextExploreCategory();
        const trigger = isConsecutiveProfile
          ? "consecutive-profile-id"
          : "repeated-profile-id-cycle";
        const repetitionMessage = isConsecutiveProfile
          ? "同じプロフィールIDが続いたため"
          : "現在のカテゴリ内でプロフィールIDが繰り返されたため";

        if (clickedCategory) {
          return {
            status: "clicked-explore-category",
            message: `${repetitionMessage}「${clickedCategory}」へ切り替えました`,
            trigger,
            clickedCategory,
            profileId,
            profileName,
            decisionCount,
          };
        }

        // 切り替え先がない場合も、以下のプロフィール判定へ進む。
        // 重複検知だけで待機し続けないよう、このカテゴリの巡回履歴を更新する。
        profileIdsInCurrentCategory.clear();
      }

      const seenProfiles = new Set(readSeenProfiles());

      if (seenProfiles.has(profileId)) {
        const profileText = getProfileText(profile);
        const lineMentionDetected = containsLineMention(profileText);
        const distanceKm = getDistances(profile)[0] ?? null;
        const reasonLabels = ["判定済み"];

        if (lineMentionDetected) {
          reasonLabels.push("LINE誘導あり（許可）");
        }

        const button = findButton("Like");

        if (!button) {
          return {
            status: "waiting",
            message: "判定済みプロフィールのLikeボタンが見つかりません",
            profileId,
            profileName,
            decisionCount,
          };
        }

        const nextCount = decisionCount + 1;
        const result = {
          status: "clicked-like",
          action: "Like",
          ...createDecisionLogFields({
            action: "Like",
            profileName,
            distanceKm,
            reasonLabels,
          }),
          distanceKm,
          lineMentionDetected,
          ...(lineMentionDetected
            ? {
                logNotes: ["LINE誘導あり（許可）"],
                lineMentionProfile: createLineMentionProfileLog({
                  profileId,
                  profileName,
                  profileText,
                  distanceKm,
                }),
              }
            : {}),
          profileId,
          profileName,
          decisionCount: nextCount,
        };

        sessionStorage.setItem(STORAGE.decisions, String(nextCount));
        appendLog(result);

        lastProcessedProfileId = profileId;
        profileIdsInCurrentCategory.add(profileId);
        button.click();
        return result;
      }

      const distances = getDistances(profile);

      if (distances.length > 1) {
        return {
          status: "error",
          message: "異なる距離表示が複数見つかりました",
          distances,
          profileId,
          profileName,
          decisionCount,
        };
      }

      const distanceKm = distances[0] ?? null;
      const profileText = getProfileText(profile);
      const decision = evaluateRules({
        profileText,
        distanceKm,
      });
      const button = findButton(decision.action);

      if (!button) {
        return {
          status: "waiting",
          message: `${decision.action}ボタンが見つかりません`,
          distanceKm,
          reasons: decision.reasons,
          profileId,
          profileName,
          decisionCount,
        };
      }

      const nextCount = decisionCount + 1;
      const nopeReasons = decision.reasons.map(formatNopeReason);
      const reasonLabels =
        decision.action === "Nope"
          ? nopeReasons
          : decision.lineMentionDetected
            ? ["LINE誘導あり（許可）"]
            : [];
      const result = {
        status: decision.action === "Nope" ? "clicked-nope" : "clicked-like",
        action: decision.action,
        ...createDecisionLogFields({
          action: decision.action,
          profileName,
          distanceKm,
          reasonLabels,
        }),
        distanceKm,
        reasons: decision.reasons,
        lineMentionDetected: decision.lineMentionDetected,
        ...(decision.lineMentionDetected
          ? {
              logNotes: ["LINE誘導あり（許可）"],
              lineMentionProfile: createLineMentionProfileLog({
                profileId,
                profileName,
                profileText,
                distanceKm,
              }),
            }
          : {}),
        ...(nopeReasons.length > 0 ? { nopeReasons } : {}),
        profileId,
        profileName,
        decisionCount: nextCount,
      };

      // クリック前に保存し、連続実行による二重押下を防止する。
      seenProfiles.add(profileId);
      writeSeenProfiles(seenProfiles);
      sessionStorage.setItem(STORAGE.decisions, String(nextCount));
      appendLog(result);

      lastProcessedProfileId = profileId;
      profileIdsInCurrentCategory.add(profileId);
      button.click();
      return result;
    } catch (error) {
      return {
        status: "error",
        message: error instanceof Error ? error.message : String(error),
      };
    }
  }

  const isIPhoneShortcut = typeof completion === "function";

  if (isIPhoneShortcut) {
    // ショートカットでは1ステップだけ実行し、即座に完了する。
    completion(JSON.stringify(runStep()));
    return;
  }

  // PCコンソールでは同じコードが自動反復する。
  window.tinderAutoJudge?.stop?.();
  resetCurrentRun();

  const controller = {
    timer: null,
    lastResult: null,

    start() {
      if (this.timer) return;

      const tick = () => {
        this.lastResult = runStep();

        if (this.lastResult.status !== "opened") {
          if (this.lastResult.summary) {
            console.log(
              `[Tinder Auto Judge] ${this.lastResult.summary}`,
              this.lastResult,
            );
          } else {
            console.log("[Tinder Auto Judge]", this.lastResult);
          }
        }
      };

      tick();
      this.timer = window.setInterval(tick, CONFIG.intervalMs);
    },

    stop() {
      if (this.timer) {
        window.clearInterval(this.timer);
        this.timer = null;
      }
      console.log("[Tinder Auto Judge] stopped");
    },

    status() {
      return {
        running: Boolean(this.timer),
        decisionCount: Number(sessionStorage.getItem(STORAGE.decisions) || "0"),
        seenProfiles: readSeenProfiles().length,
        lastResult: this.lastResult,
      };
    },

    resetHistory() {
      try {
        localStorage.removeItem(STORAGE.seen);
      } catch {
        // localStorageを利用できない環境ではsessionStorageのみ消去する。
      }
      sessionStorage.removeItem(STORAGE.seen);
      sessionStorage.removeItem(STORAGE.decisions);
      lastProcessedProfileId = null;
      profileIdsInCurrentCategory.clear();
      console.log("[Tinder Auto Judge] 判定済み履歴を消去しました");
    },
  };

  window.tinderAutoJudge = controller;
  controller.start();
})();
